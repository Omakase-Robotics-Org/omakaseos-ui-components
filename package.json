{
  "name": "@omakase-robotics/ui-components",
  "version": "0.7.1",
  "description": "Shared React component library for omakase-robotics web UIs (omakaseos_service web + status_server_webui). v0.1–v0.2 status primitives, v0.3 form & layout primitives, v0.4 conversation-log primitives, v0.5 live-conversation primitives (Google Meet 1:n stage), v0.6 canonical assistant-ui primitives (Thread / Composer / MarkdownText / Tool / Reasoning / Voice — vendored from the shadcn-style assistant-ui registry, Tailwind v4 in-package), v0.7 AsyncCombobox (type-to-search over an async candidate list — the library's only synthetic ARIA widget, bounded by an automated boundary spec).",
  "type": "module",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./aliases/status-server-webui.css": "./aliases/status-server-webui.css",
    "./aliases/omks-robo-web.css": "./aliases/omks-robo-web.css",
    "./tokens.css": "./src/tokens.css",
    "./aui": {
      "types": "./dist/aui/index.d.ts",
      "import": "./dist/aui/index.js"
    },
    "./aui/aui.css": "./dist/aui/aui.css"
  },
  "files": [
    "src",
    "aliases",
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build:demo": "vite build --config vite.config.ts",
    "build:aui:js": "vite build --config vite.aui.config.ts",
    "build:aui:css": "tailwindcss -i ./src/aui/aui.css -o ./dist/aui/aui.css",
    "build:aui": "bun run build:aui:js && bun run build:aui:css",
    "build": "bun run build:aui && bun run build:demo",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest --run",
    "test:e2e": "./scripts/run-e2e.sh",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@assistant-ui/react": "^0.14.0",
    "@assistant-ui/react-markdown": "^0.14.0",
    "lucide-react": ">=0.468.0 <2.0.0",
    "radix-ui": "^1.6.0",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-tooltip": "^1.2.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "remark-gfm": "^4.0.0",
    "tailwind-merge": "^3.0.0",
    "zustand": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@assistant-ui/react": {
      "optional": true
    },
    "@assistant-ui/react-markdown": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    },
    "radix-ui": {
      "optional": true
    },
    "@radix-ui/react-slot": {
      "optional": true
    },
    "@radix-ui/react-tooltip": {
      "optional": true
    },
    "class-variance-authority": {
      "optional": true
    },
    "clsx": {
      "optional": true
    },
    "remark-gfm": {
      "optional": true
    },
    "tailwind-merge": {
      "optional": true
    },
    "zustand": {
      "optional": true
    }
  },
  "devDependencies": {
    "@assistant-ui/react": "^0.14.23",
    "@assistant-ui/react-markdown": "^0.14.4",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.10",
    "@storybook/addon-a11y": "^8.6",
    "@storybook/addon-essentials": "^8.6",
    "@storybook/addon-themes": "^8.6",
    "@storybook/react-vite": "^8.6",
    "@storybook/test": "^8.6",
    "@tailwindcss/cli": "^4.3.1",
    "@tailwindcss/vite": "^4.1.16",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jsdom": "^29.0.1",
    "lucide-react": "^1.25.0",
    "playwright": "^1.61.0",
    "radix-ui": "^1.6.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "remark-gfm": "^4.0.1",
    "storybook": "^8.6",
    "tailwind-merge": "^3.3.2",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3",
    "vite": "^8.0.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.0",
    "zustand": "^5.0.8"
  },
  "packageManager": "bun@1.3.11"
}
