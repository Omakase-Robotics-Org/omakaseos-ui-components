{
  "name": "@omakase-robotics/ui-components",
  "version": "0.2.0",
  "description": "Shared L1 React component library for omakase-robotics web UIs (omakaseos_service web + status_server_webui).",
  "type": "module",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./aliases/status-server-webui.css": "./aliases/status-server-webui.css",
    "./aliases/omks-robo-web.css": "./aliases/omks-robo-web.css",
    "./tokens.css": "./src/tokens.css"
  },
  "files": [
    "src",
    "aliases",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "vite build --config vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest --run"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^29.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.9.3",
    "vite": "^8.0.1",
    "vitest": "^4.1.0"
  },
  "packageManager": "bun@1.3.11"
}
